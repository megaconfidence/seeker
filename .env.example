# Your Soulseek network account. Any unused name/password creates one on first login.
SLSK_USERNAME=
SLSK_PASSWORD=

# Password for the Seeker web UI at http://localhost:7335
SEEKER_PASSWORD=

# Login for the slskd web UI at http://localhost:5030
SLSKD_WEB_USERNAME=admin
SLSKD_WEB_PASSWORD=change-me

# API key Seeker uses to talk to slskd (16+ characters). Generate one with:
#   openssl rand -hex 24
SLSKD_API_KEY=

# Where your library and slskd's downloads live on this machine
MUSIC_DIR=./music
DOWNLOADS_DIR=./downloads
# Music you already have, for Seeker to tag and add to the library (Library → Import music)
IMPORT_DIR=./import

# Optional: fingerprint every download to make sure it's the right song.
# Free key at https://acoustid.org/new-application
ACOUSTID_API_KEY=

TZ=UTC
PUID=1000
PGID=1000

# Only used by the compose files from the deploy folder (the published image):
# The published Seeker image. For your own fork, use ghcr.io/<your-github-user>/seeker:latest (lowercase).
SEEKER_IMAGE=ghcr.io/megaconfidence/seeker:latest
# Domain for HTTPS through Caddy (docker-compose.https.yml), for example music.example.com
SEEKER_DOMAIN=
# Uncomment to use HTTPS with every docker compose command
#COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
