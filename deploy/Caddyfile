# Seeker over HTTPS. Caddy gets a certificate for SEEKER_DOMAIN (set in .env) and renews it.
# After changing this file, run: docker compose restart caddy

{$SEEKER_DOMAIN} {
	# LAN only, without a public domain: set SEEKER_DOMAIN to the server's local name or IP
	# address and uncomment the next line. Caddy then signs the certificate itself, and browsers
	# warn until you trust its root certificate, which this copies out:
	#   docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt .
	# tls internal

	encode zstd gzip

	# Live updates (/api/events) are Server-Sent Events. Caddy flushes text/event-stream
	# responses as they arrive, so they need no extra settings.
	reverse_proxy seeker:7335
}
